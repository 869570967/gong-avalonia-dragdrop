<Window x:Class="Showcase.Avalonia.DragDrop.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dd="using:GongSolutions.Avalonia.DragDrop"
        xmlns:local="using:Showcase.Avalonia.DragDrop"
        x:DataType="local:MainViewModel"
        Width="1000"
        Height="700"
        MinWidth="700"
        MinHeight="600"
        Background="#F3F4F6"
        Title="GongSolutions.Avalonia.DragDrop">
    <Window.Styles>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2563EB" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.listPanel">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="ListBox.dragList">
            <Setter Property="MinHeight" Value="320" />
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SelectionMode" Value="Multiple" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="28" RowSpacing="18">
        <StackPanel Spacing="5">
            <TextBlock Classes="eyebrow" Text="AVALONIA 12.1.1" />
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Drag and drop showcase" />
            <TextBlock Foreground="#4B5563"
                       Text="Drag within a list to reorder, between lists to move, or hold Ctrl to copy." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="18">
            <Border Classes="listPanel">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <StackPanel>
                        <TextBlock Classes="heading" Text="Source collection" />
                        <TextBlock Foreground="#6B7280" Text="Multiple selection supported" />
                    </StackPanel>
                    <ListBox Grid.Row="1"
                             Classes="dragList"
                             ItemsSource="{Binding SourceItems}"
                             dd:DragDrop.DragDropContext="Main"
                             dd:DragDrop.IsDragSource="True"
                             dd:DragDrop.IsDropTarget="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:ItemModel">
                                <Grid ColumnDefinitions="38,*">
                                    <TextBlock Foreground="#9CA3AF" Text="{Binding Index}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Caption}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="listPanel">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <StackPanel>
                        <TextBlock Classes="heading" Text="Target collection" />
                        <TextBlock Foreground="#6B7280" Text="Drop before or after an item" />
                    </StackPanel>
                    <ListBox Grid.Row="1"
                             Classes="dragList"
                             ItemsSource="{Binding TargetItems}"
                             dd:DragDrop.DragDropContext="Main"
                             dd:DragDrop.IsDragSource="True"
                             dd:DragDrop.IsDropTarget="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:ItemModel">
                                <Grid ColumnDefinitions="38,*">
                                    <TextBlock Foreground="#9CA3AF" Text="{Binding Index}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Caption}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="12"
                Background="#EFF6FF"
                BorderBrush="#BFDBFE"
                BorderThickness="1"
                CornerRadius="6">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <TextBlock FontWeight="SemiBold" Foreground="#1D4ED8" Text="Context guard" />
                <ListBox Grid.Column="1"
                         Height="46"
                         ItemsSource="{Binding IsolatedItems}"
                         dd:DragDrop.DragDropContext="Isolated"
                         dd:DragDrop.IsDropTarget="True" />
            </Grid>
        </Border>
    </Grid>
</Window>