<Window x:Class="Showcase.Avalonia.DragDrop.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dd="using:GongSolutions.Avalonia.DragDrop"
        xmlns:local="using:Showcase.Avalonia.DragDrop"
        x:DataType="local:MainViewModel"
        Width="1000"
        Height="700"
        MinWidth="700"
        MinHeight="600"
        Background="#F3F4F6"
        Title="GongSolutions.Avalonia.DragDrop">
    <Window.Resources>
        <local:TreeDropHandler x:Key="TreeDropHandler" />
    </Window.Resources>
    <Window.Styles>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2563EB" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.listPanel">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="ListBox.dragList">
            <Setter Property="MinHeight" Value="320" />
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SelectionMode" Value="Multiple" />
        </Style>
        <Style Selector="ListBox.dragList ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="ListBox.dragList ListBoxItem:pointerover">
            <Setter Property="Background" Value="#EFF6FF" />
        </Style>
        <Style Selector="ListBox.dragList ListBoxItem:selected">
            <Setter Property="Background" Value="#DBEAFE" />
        </Style>
        <Style Selector="TreeView.dragTree">
            <Setter Property="MinHeight" Value="320" />
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TreeView.dragTree TreeViewItem">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="IsExpanded" Value="True" />
        </Style>
        <Style Selector="TreeView.dragTree TreeViewItem:pointerover">
            <Setter Property="Background" Value="#EFF6FF" />
        </Style>
        <Style Selector="TreeView.dragTree TreeViewItem:selected">
            <Setter Property="Background" Value="#DBEAFE" />
        </Style>
        <Style Selector="DataGrid.dragGrid">
            <Setter Property="MinHeight" Value="320" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="DataGrid.dragGrid DataGridRow:pointerover">
            <Setter Property="Background" Value="#EFF6FF" />
        </Style>
        <Style Selector="DataGrid.dragGrid DataGridRow:selected">
            <Setter Property="Background" Value="#DBEAFE" />
        </Style>
        <Style Selector="TabControl.dragTabs TabItem">
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
        <Style Selector="TabControl.dragTabs TabItem:pointerover">
            <Setter Property="Background" Value="#EFF6FF" />
        </Style>
        <Style Selector="TabControl.dragTabs TabItem:selected">
            <Setter Property="Background" Value="#DBEAFE" />
        </Style>
        <Style Selector="ItemsControl.dragItems > ContentPresenter">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style Selector="ItemsControl.dragItems > ContentPresenter:pointerover">
            <Setter Property="Background" Value="#EFF6FF" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="28" RowSpacing="18">
        <StackPanel Spacing="5">
            <TextBlock Classes="eyebrow" Text="AVALONIA 12.1.1" />
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Drag and drop showcase" />
            <TextBlock Foreground="#4B5563"
                       Text="Reorder list items or move tree nodes between levels. Hold Ctrl to copy." />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Lists">
                <Grid Margin="0,12,0,0" ColumnDefinitions="*,*" ColumnSpacing="18">
                    <Border Classes="listPanel">
                        <Grid RowDefinitions="Auto,*" RowSpacing="12">
                            <StackPanel>
                                <TextBlock Classes="heading" Text="Source collection" />
                                <TextBlock Foreground="#6B7280" Text="Multiple selection supported" />
                            </StackPanel>
                            <ListBox Grid.Row="1"
                                     Classes="dragList"
                                     ItemsSource="{Binding SourceItems}"
                                     dd:DragDrop.DragDropContext="Main"
                                     dd:DragDrop.IsDragSource="True"
                                     dd:DragDrop.IsDropTarget="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:ItemModel">
                                        <Grid ColumnDefinitions="38,*">
                                            <TextBlock Foreground="#9CA3AF" Text="{Binding Index}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Caption}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Classes="listPanel">
                        <Grid RowDefinitions="Auto,*" RowSpacing="12">
                            <StackPanel>
                                <TextBlock Classes="heading" Text="Target collection" />
                                <TextBlock Foreground="#6B7280" Text="Drop before or after an item" />
                            </StackPanel>
                            <ListBox Grid.Row="1"
                                     Classes="dragList"
                                     ItemsSource="{Binding TargetItems}"
                                     dd:DragDrop.DragDropContext="Main"
                                     dd:DragDrop.IsDragSource="True"
                                     dd:DragDrop.IsDropTarget="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:ItemModel">
                                        <Grid ColumnDefinitions="38,*">
                                            <TextBlock Foreground="#9CA3AF" Text="{Binding Index}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Caption}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Tree">
                <Border Margin="0,12,0,0" Classes="listPanel">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                        <Grid RowDefinitions="Auto,*" RowSpacing="12">
                            <StackPanel>
                                <TextBlock Classes="heading" Text="Bound tree" />
                                <TextBlock Foreground="#6B7280" Text="Leaf nodes reject child drops" />
                            </StackPanel>
                            <TreeView Grid.Row="1"
                                      Classes="dragTree"
                                      ItemsSource="{Binding TreeItems}"
                                      dd:DragDrop.DragDropContext="Main"
                                      dd:DragDrop.DropHandler="{StaticResource TreeDropHandler}"
                                      dd:DragDrop.IsDragSource="True"
                                      dd:DragDrop.IsDropTarget="True">
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate x:DataType="local:TreeNodeModel" ItemsSource="{Binding Children}">
                                        <TextBlock Padding="8,5" Text="{Binding Caption}" />
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>

                        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">
                            <StackPanel>
                                <TextBlock Classes="heading" Text="Unbound tree" />
                                <TextBlock Foreground="#6B7280" Text="Uses direct TreeViewItem children" />
                            </StackPanel>
                            <TreeView Grid.Row="1"
                                      Classes="dragTree"
                                      dd:DragDrop.DragDropContext="UnboundTree"
                                      dd:DragDrop.DropHandler="{StaticResource TreeDropHandler}"
                                      dd:DragDrop.IsDragSource="True"
                                      dd:DragDrop.IsDropTarget="True">
                                <TreeViewItem Header="Workspace" IsExpanded="True">
                                    <TreeViewItem Header="Source" />
                                    <TreeViewItem Header="Tests" />
                                </TreeViewItem>
                                <TreeViewItem Header="Archive" IsExpanded="True">
                                    <TreeViewItem Header="Old versions" />
                                </TreeViewItem>
                                <TreeViewItem Header="Inbox" />
                            </TreeView>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="DataGrid">
                <Grid Margin="0,12,0,0" ColumnDefinitions="*,*" ColumnSpacing="18">
                    <Border Classes="listPanel">
                        <Grid RowDefinitions="Auto,*" RowSpacing="12">
                            <StackPanel>
                                <TextBlock Classes="heading" Text="Source rows" />
                                <TextBlock Foreground="#6B7280" Text="Select multiple rows before dragging" />
                            </StackPanel>
                            <DataGrid Grid.Row="1"
                                      Classes="dragGrid"
                                      ItemsSource="{Binding DataGridSourceItems}"
                                      AutoGenerateColumns="False"
                                      CanUserReorderColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Extended"
                                      dd:DragDrop.DragDropContext="DataGrid"
                                      dd:DragDrop.ScrollingMode="VerticalOnly"
                                      dd:DragDrop.IsDragSource="True"
                                      dd:DragDrop.IsDropTarget="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Index}" Width="80" />
                                    <DataGridTextColumn Header="Caption" Binding="{Binding Caption}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Classes="listPanel">
                        <Grid RowDefinitions="Auto,*" RowSpacing="12">
                            <StackPanel>
                                <TextBlock Classes="heading" Text="Target rows" />
                                <TextBlock Foreground="#6B7280" Text="Drop above or below a row" />
                            </StackPanel>
                            <DataGrid Grid.Row="1"
                                      Classes="dragGrid"
                                      ItemsSource="{Binding DataGridTargetItems}"
                                      AutoGenerateColumns="False"
                                      CanUserReorderColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Extended"
                                      dd:DragDrop.DragDropContext="DataGrid"
                                      dd:DragDrop.ScrollingMode="VerticalOnly"
                                      dd:DragDrop.IsDragSource="True"
                                      dd:DragDrop.IsDropTarget="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Index}" Width="80" />
                                    <DataGridTextColumn Header="Caption" Binding="{Binding Caption}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Tabs">
                <Grid Margin="0,12,0,0" RowDefinitions="*,*" RowSpacing="18">
                    <Border Classes="listPanel">
                        <TabControl Classes="dragTabs"
                                    ItemsSource="{Binding TabSourceItems}"
                                    dd:DragDrop.DragDropContext="Tabs"
                                    dd:DragDrop.IsDragSource="True"
                                    dd:DragDrop.IsDropTarget="True">
                            <TabControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ItemModel">
                                    <TextBlock Text="{Binding Caption}" />
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate x:DataType="local:ItemModel">
                                    <TextBlock Margin="16" FontSize="18" Text="{Binding Caption}" />
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </Border>
                    <Border Grid.Row="1" Classes="listPanel">
                        <TabControl Classes="dragTabs"
                                    ItemsSource="{Binding TabTargetItems}"
                                    dd:DragDrop.DragDropContext="Tabs"
                                    dd:DragDrop.IsDragSource="True"
                                    dd:DragDrop.IsDropTarget="True">
                            <TabControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ItemModel">
                                    <TextBlock Text="{Binding Caption}" />
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate x:DataType="local:ItemModel">
                                    <TextBlock Margin="16" FontSize="18" Text="{Binding Caption}" />
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="ItemsControl">
                <Border Margin="0,12,0,0" Classes="listPanel">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12">
                        <StackPanel>
                            <TextBlock Classes="heading" Text="Plain ItemsControl" />
                            <TextBlock Foreground="#6B7280" Text="Drag generated containers to reorder the collection" />
                        </StackPanel>
                        <ItemsControl Grid.Row="1"
                                      Classes="dragItems"
                                      ItemsSource="{Binding PlainItems}"
                                      dd:DragDrop.DragDropContext="ItemsControl"
                                      dd:DragDrop.IsDragSource="True"
                                      dd:DragDrop.IsDropTarget="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ItemModel">
                                        <Border Padding="0,8"
                                            Background="Transparent"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="60,*">
                                            <TextBlock Foreground="#9CA3AF" Text="{Binding Index}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Caption}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Padding="12"
                Background="#EFF6FF"
                BorderBrush="#BFDBFE"
                BorderThickness="1"
                CornerRadius="6">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <TextBlock FontWeight="SemiBold" Foreground="#1D4ED8" Text="Context guard" />
                <ListBox Grid.Column="1"
                         Height="46"
                         ItemsSource="{Binding IsolatedItems}"
                         dd:DragDrop.DragDropContext="Isolated"
                         dd:DragDrop.IsDropTarget="True" />
            </Grid>
        </Border>
    </Grid>
</Window>